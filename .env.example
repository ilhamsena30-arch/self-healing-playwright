# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values for your environment.
# `.env` is git-ignored; this example file is committed.
# ---------------------------------------------------------------------------

# --- Runner -----------------------------------------------------------------
ENV=local
CI=false
WORKERS=2
RETRIES=1
TIMEOUT_MS=45000
EXPECT_TIMEOUT_MS=10000
HEADLESS=true
SLOW_MO=0
VIDEO=retain-on-failure
TRACEE=retain-on-failure

# --- Target under test ------------------------------------------------------
# UI target: the public test-automation playground (one standalone page per scenario).
BASE_URL=https://practice.expandtesting.com
# The playground exposes no REST API; point this at a JSON API when you exercise src/api.
API_BASE_URL=https://api.example.com

# --- Test credentials (PLACEHOLDER values) ---------------------------------
TEST_USERNAME=tester@example.com
TEST_PASSWORD=SuperSecret123!
TEST_TOKEN=placeholder-bearer-token

# --- Redis (Upstash REST) ---------------------------------------------------
# Get these from https://console.upstash.com -> your database -> REST API
# Never commit a real token; set REDIS_TOKEN in your shell/CI secrets instead.
REDIS_URL=https://fluent-worm-177361.upstash.io
REDIS_TOKEN=
REDIS_KEY_PREFIX=e2e
REDIS_FLUSH_ON_START=false

# --- Self-healing (Tier 2 Redis cache + Tier 3 LLM) -------------------------
# ioredis URI for the healed_locators cache. Leave empty to derive an upstash://
# URI from REDIS_URL + REDIS_TOKEN, or to fall back to redis://localhost:6379.
HEALING_REDIS_URL=
HEALING_REDIS_PASSWORD=
# DeepSeek API key for semantic repair. Empty disables Tier 3/4.
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
HEALING_CONFIDENCE_THRESHOLD=0.8
HEALING_TIMEOUT_MS=2500

# --- Reporting --------------------------------------------------------------
REPORT_OPEN=never
