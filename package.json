{
  "name": "self-healing-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript UI automation boilerplate (Flow / ScreenPage / Redis / API).",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rimraf dist playwright-report test-results blob-report .cache",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "redis:ping": "tsx scripts/redis-ping.ts",
    "seed": "tsx scripts/seed-redis.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "dotenv": "^16.4.5",
    "ioredis": "^6.0.0",
    "openai": "^7.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
